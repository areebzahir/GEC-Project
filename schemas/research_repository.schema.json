{
  "$defs": {
    "ColumnRole": {
      "description": "A coarse hint about how a column is used, for display and matching context.",
      "enum": [
        "identifier",
        "categorical",
        "measure",
        "temporal",
        "text"
      ],
      "title": "ColumnRole",
      "type": "string"
    },
    "ColumnStatistics": {
      "description": "One-pass profile of a column (DESIGN.md section 13).",
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "distinct": {
          "title": "Distinct",
          "type": "integer"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "missing": {
          "title": "Missing",
          "type": "integer"
        },
        "std": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std"
        },
        "top_values": {
          "items": {
            "type": "string"
          },
          "title": "Top Values",
          "type": "array"
        }
      },
      "required": [
        "count",
        "missing",
        "distinct"
      ],
      "title": "ColumnStatistics",
      "type": "object"
    },
    "ColumnType": {
      "description": "Logical column types, a readable subset of Frictionless Table Schema (Ref [14]).",
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "date",
        "datetime",
        "time"
      ],
      "title": "ColumnType",
      "type": "string"
    },
    "Dataset": {
      "description": "One data table (one CSV/TAB file, or one Excel sheet).",
      "properties": {
        "column_count": {
          "title": "Column Count",
          "type": "integer"
        },
        "declared": {
          "$ref": "#/$defs/DeclaredCounts"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "documented_as": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Documented As"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "format": {
          "title": "Format",
          "type": "string"
        },
        "headers": {
          "items": {
            "type": "string"
          },
          "title": "Headers",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "last_updated": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Updated"
        },
        "records": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Records",
          "type": "array"
        },
        "records_included": {
          "default": 0,
          "title": "Records Included",
          "type": "integer"
        },
        "records_truncated": {
          "default": false,
          "title": "Records Truncated",
          "type": "boolean"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        },
        "structure": {
          "$ref": "#/$defs/DatasetStructure"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "unmatched_documented_variables": {
          "items": {
            "$ref": "#/$defs/UnmatchedVariable"
          },
          "title": "Unmatched Documented Variables",
          "type": "array"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/Variable"
          },
          "title": "Variables",
          "type": "array"
        },
        "worksheet_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worksheet Name"
        }
      },
      "required": [
        "id",
        "file",
        "format",
        "structure",
        "row_count",
        "column_count"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "DatasetStructure": {
      "description": "How the physical table was read (DESIGN.md sections 10, 12).",
      "properties": {
        "delimiter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delimiter"
        },
        "encoding": {
          "title": "Encoding",
          "type": "string"
        },
        "header_confidence": {
          "default": 1.0,
          "title": "Header Confidence",
          "type": "number"
        },
        "header_row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Row"
        },
        "quote_char": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Char"
        }
      },
      "required": [
        "encoding"
      ],
      "title": "DatasetStructure",
      "type": "object"
    },
    "DateRange": {
      "description": "A collection period. ``text`` always preserves the original string.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "DeclaredCounts": {
      "description": "Counts the README claimed, kept so we can cross-check them (DESIGN.md section 13).",
      "properties": {
        "row_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "variable_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variable Count"
        }
      },
      "title": "DeclaredCounts",
      "type": "object"
    },
    "DocumentInfo": {
      "description": "A documentation file we parsed and which datasets it describes.",
      "properties": {
        "describes": {
          "items": {
            "type": "string"
          },
          "title": "Describes",
          "type": "array"
        },
        "encoding": {
          "title": "Encoding",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "format": {
          "title": "Format",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/DocumentSection"
          },
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "file",
        "format",
        "encoding"
      ],
      "title": "DocumentInfo",
      "type": "object"
    },
    "DocumentSection": {
      "properties": {
        "lines": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Lines",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "lines"
      ],
      "title": "DocumentSection",
      "type": "object"
    },
    "FileRecord": {
      "description": "One file found in the repository and what became of it.",
      "properties": {
        "format": {
          "title": "Format",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "tabular",
            "documentation",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "status": {
          "enum": [
            "processed",
            "skipped",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "path",
        "role",
        "format",
        "size_bytes",
        "sha256",
        "status"
      ],
      "title": "FileRecord",
      "type": "object"
    },
    "Issue": {
      "description": "One categorized, explainable problem.",
      "properties": {
        "code": {
          "$ref": "#/$defs/IssueCode"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/IssueLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "technical_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technical Detail"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "IssueCode": {
      "description": "Catalogue of everything that can go wrong, grouped by stage.",
      "enum": [
        "INPUT_NOT_FOUND",
        "NO_FILES_FOUND",
        "FILE_TOO_LARGE",
        "TOO_MANY_FILES",
        "UNSUPPORTED_FILE",
        "ZIP_UNSAFE_MEMBER",
        "ZIP_LIMIT_EXCEEDED",
        "ENCODING_FALLBACK",
        "ENCODING_REPLACED_CHARS",
        "README_NOT_FOUND",
        "README_MULTIPLE",
        "README_UNREADABLE",
        "CONFLICTING_METADATA",
        "CSV_RAGGED_ROWS",
        "CSV_QUOTE_FALLBACK",
        "CSV_PARSE_FAILED",
        "DELIMITER_UNCERTAIN",
        "EXCEL_CORRUPT",
        "EXCEL_HIDDEN_SHEET",
        "EXCEL_EMPTY_SHEET",
        "EXCEL_FORMULA_NO_CACHED_VALUE",
        "HEADER_NOT_FOUND",
        "HEADER_AMBIGUOUS",
        "HEADER_DUPLICATE",
        "HEADER_BLANK",
        "AMBIGUOUS_DATE_FORMAT",
        "POSSIBLE_UNDECLARED_MISSING_CODE",
        "DECLARED_COUNT_MISMATCH",
        "MATCH_AMBIGUOUS",
        "MATCH_LOW_CONFIDENCE",
        "VARIABLE_UNDOCUMENTED",
        "DOCUMENTED_VARIABLE_NOT_IN_DATA",
        "SCHEMA_VALIDATION_FAILED",
        "INTERNAL_ERROR"
      ],
      "title": "IssueCode",
      "type": "string"
    },
    "IssueLocation": {
      "description": "Where a problem lives, so a user (or a future GUI) can jump straight to it.",
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "lines": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lines"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        }
      },
      "title": "IssueLocation",
      "type": "object"
    },
    "KeyValue": {
      "description": "A README key/value we kept but did not map to a canonical field (nothing is dropped).",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null
