        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "stage_durations_ms": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Stage Durations Ms",
          "type": "object"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
