      ],
      "title": "MatchAlternative",
      "type": "object"
    },
    "MatchStatus": {
      "enum": [
        "matched",
        "ambiguous",
        "unmatched"
      ],
      "title": "MatchStatus",
      "type": "string"
    },
    "MethodologyNote": {
      "properties": {
        "heading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "MethodologyNote",
      "type": "object"
    },
    "Person": {
      "description": "An author/investigator/contact parsed from the README (DataCite 'creator', Ref [17]).",
